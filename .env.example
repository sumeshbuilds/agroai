# Copy this file to `.env.local` and fill in the values.

# Neon Postgres connection string (required for farms, crops and reports).
DATABASE_URL=

# Signed-session secret for name + PIN login (required in production).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Optional: set to "false" only for local `next start` smoke tests over http.
# AUTH_COOKIE_SECURE=false

# Google Gemini API key (optional — a rule-based fallback is used when empty).
GEMINI_API_KEY=

# Optional: override the Gemini model (default: gemini-3.8-flash).
# GEMINI_MODEL=gemini-3.8-flash

# Optional: protect /api/cron/weekly-report with a shared secret.
# CRON_SECRET=
