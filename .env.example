# Copy this file to `.env.local` and fill in the values.

# Neon Postgres connection string (required for farms, crops and reports).
DATABASE_URL=

# Signed-session secret for name + PIN login (required in production).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Optional: set to "false" only for local `next start` smoke tests over http.
# AUTH_COOKIE_SECURE=false

# Google Gemini API key. Required for the plant doctor photo scan; the weekly
# advisory uses a rule-based fallback when this is empty.
GEMINI_API_KEY=

# Optional: override the Gemini model (default: gemini-3.8-flash).
# GEMINI_MODEL=gemini-3.8-flash

# Optional: override the Gemini endpoint for a proxy or local mock.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Optional: plant-scan Gemini timeout in ms (default: 40000, max: 55000).
# DISEASE_GEMINI_TIMEOUT_MS=40000

# Optional: protect /api/cron/weekly-report with a shared secret.
# CRON_SECRET=

# Groq vision verifier (optional). When set, each new human/animal track is
# double-checked by a fast multimodal model to refine species and drop false
# positives. Nothing is sent when this key is empty.
GROQ_API_KEY=

# Optional: override the Groq vision model (default: qwen/qwen3.8-27b).
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Optional: Groq request timeout in ms (default: 4500, max: 15000).
# GROQ_TIMEOUT_MS=4500

# Optional: plant-scan fallback model/timeout. Used only when Gemini is
# unavailable or unconfigured (defaults: qwen/qwen3.8-27b, 18000 ms).
# GROQ_DISEASE_MODEL=qwen/qwen3.8-27b
# GROQ_DISEASE_TIMEOUT_MS=18000

# Optional: override the OpenAI-compatible endpoint.
# GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions

# Optional: Amazon Associates tag added to product search links in weekly plans.
# Leave empty to show plain Amazon.in search links with no affiliate tracking.
# NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=
