# Copy this file to `.env.local` and fill in the values.

# Neon Postgres connection string (required for farms, crops and reports).
DATABASE_URL=

# Signed-session secret for name + PIN login (required in production).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Optional: set to "false" only for local `next start` smoke tests over http.
# AUTH_COOKIE_SECURE=false

# Google Gemini API key. Required for the plant doctor photo scan; the weekly
# advisory uses a rule-based fallback when this is empty.
GEMINI_API_KEY=

# Optional: override the Gemini model (default: gemini-3.8-flash).
# GEMINI_MODEL=gemini-3.8-flash

# Optional: override the Gemini endpoint for a proxy or local mock.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Optional: plant-scan Gemini timeout in ms (default: 40000, max: 55000).
# DISEASE_GEMINI_TIMEOUT_MS=40000

# Optional: protect /api/cron/weekly-report with a shared secret.
# CRON_SECRET=

# Groq vision verifier (optional). When set, each new human/animal track is
# double-checked by a fast multimodal model to refine species and drop false
# positives. Nothing is sent when this key is empty.
GROQ_API_KEY=

# Optional: override the Groq vision model (default: qwen/qwen3.8-27b).
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Optional: Groq request timeout in ms (default: 4500, max: 15000).
# GROQ_TIMEOUT_MS=4500

# Optional: plant-scan fallback model/timeout. Also used for the independent
# second opinion when the first read is uncertain (defaults: qwen/qwen3.8-27b,
# 18000 ms; the second opinion is capped at 12 s).
# GROQ_DISEASE_MODEL=qwen/qwen3.8-27b
# GROQ_DISEASE_TIMEOUT_MS=18000

# Optional: disable the second-opinion cross-check (default: enabled when
# GROQ_API_KEY is set). Set to "false" to save tokens/latency.
# DISEASE_SECOND_OPINION=false

# Optional: override the OpenAI-compatible endpoint.
# GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions

# Optional: Amazon Associates tag added to product search links in weekly plans.
# Leave empty to show plain Amazon.in search links with no affiliate tracking.
# NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=

# Optional: open plant-disease classifier (Hugging Face Inference). When set, it
# runs in parallel with Gemini and acts as a consensus signal. It never replaces
# the explainable vision read, and it is skipped when the crop is outside the
# model's label set.
HF_API_TOKEN=
# HF_DISEASE_MODEL=linkanjarad/mobilenet_v2_1.0_224-plant-disease-identification
# HF_TIMEOUT_MS=12000

# Optional: Sentinel-2 vegetation checks through the Copernicus Data Space
# Sentinel Hub Statistical API. Create a free OAuth client in the CDSE
# dashboard. Leave empty to show the honest "not connected" state.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
# CDSE_STATISTICS_URL=https://sh.dataspace.copernicus.eu/api/v1/statistics
# SATELLITE_LOOKBACK_DAYS=45
# SATELLITE_MAX_CLOUD=45
