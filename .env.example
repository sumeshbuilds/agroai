# Copy this file to `.env.local` and fill in the values.

# Neon Postgres connection string (required for farms, crops and reports).
DATABASE_URL=

# Signed-session secret for name + PIN login (required in production).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Optional: set to "false" only for local `next start` smoke tests over http.
# AUTH_COOKIE_SECURE=false

# Canonical public origin used by metadata, sitemap.xml, robots.txt and JSON-LD.
# Must be the host Google actually serves (the apex redirects to www).
# NEXT_PUBLIC_SITE_URL=https://www.agroai.co.in

# Google Search Console verification token — just the `content` value from the
# "HTML tag" method. Emitted as <meta name="google-site-verification"> site-wide.
# GOOGLE_SITE_VERIFICATION=

# Google Gemini API key. Used to write the plant-doctor action plan and the
# weekly advisory. Optional: photo identification itself works with only a
# PLANTNET_API_KEY (see below), and the weekly advisory falls back to rules.
GEMINI_API_KEY=

# Optional: override the Gemini model (default: gemini-3.8-flash).
# GEMINI_MODEL=gemini-3.8-flash

# Optional: override the Gemini endpoint for a proxy or local mock.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Optional: plant-scan Gemini timeout in ms (default: 40000, max: 55000).
# DISEASE_GEMINI_TIMEOUT_MS=40000

# Optional: retry a busy Gemini model (429/5xx or "high demand") this many
# times before giving up. Default: 2, max: 4.
# DISEASE_GEMINI_ATTEMPTS=2

# Optional: comma-separated fallback Gemini models tried when the primary keeps
# returning 503/high-demand. Defaults to the current lite models, which stay
# available when `gemini-3.8-flash` is throttled.
# GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.5-flash-lite

# Optional: protect /api/cron/weekly-report with a shared secret.
# CRON_SECRET=

# Pl@ntNet API key for plant + disease identification on uploaded photos.
# Create a free key at https://my.plantnet.org/settings/api-key and paste it
# here. The server calls /v2/identify (species) and /v2/diseases/identify
# (EPPO-coded diseases); the key stays on the server and is never sent to the
# browser. Free tier has a daily request quota.
PLANTNET_API_KEY=

# Optional: restrict species identification to one flora/referential
# (e.g. "k-world-flora", "weurope", "canada"). Default: "all".
# PLANTNET_PROJECT=all

# Optional: result language for common names (e.g. "en", "fr"). Default: "en".
# PLANTNET_LANG=en

# Optional: Pl@ntNet request timeout in ms (default: 20000, max: 55000).
# PLANTNET_TIMEOUT_MS=20000

# Optional: override the Pl@ntNet endpoint for a proxy or local mock.
# PLANTNET_BASE_URL=https://my-api.plantnet.org

# Groq vision verifier (optional). When set, each new human/animal track is
# double-checked by a fast multimodal model to refine species and drop false
# positives. Nothing is sent when this key is empty.
GROQ_API_KEY=

# Optional: override the Groq vision model (default: qwen/qwen3.8-27b).
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Optional: Groq request timeout in ms (default: 4500, max: 15000).
# GROQ_TIMEOUT_MS=4500

# Optional: plant-scan fallback model/timeout. Also used for the independent
# second opinion when the first read is uncertain (defaults: qwen/qwen3.8-27b,
# 18000 ms; the second opinion is capped at 12 s).
# GROQ_DISEASE_MODEL=qwen/qwen3.8-27b
# GROQ_DISEASE_TIMEOUT_MS=18000

# Optional: Groq model/timeout used to translate AI-written text to Odia when
# Gemini is busy or exhausted. Falls back to GROQ_DISEASE_MODEL / the default.
# GROQ_TRANSLATE_MODEL=qwen/qwen3.8-27b
# GROQ_TEXT_TIMEOUT_MS=18000

# Optional: disable the second-opinion cross-check (default: enabled when
# GROQ_API_KEY is set). Set to "false" to save tokens/latency.
# DISEASE_SECOND_OPINION=false

# Optional: when Pl@ntNet has already identified the plant, wait at most this
# long (ms) for the vision model before answering with Pl@ntNet alone.
# Default: 30000, min: 500, max: 55000.
# DISEASE_VISION_SOFT_DEADLINE_MS=30000

# Optional: override the OpenAI-compatible endpoint.
# GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions

# Optional: Amazon Associates tag added to product search links in weekly plans.
# Leave empty to show plain Amazon.in search links with no affiliate tracking.
# NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=

# Optional: open plant-disease classifier (Hugging Face Inference). When set, it
# runs in parallel with Gemini and acts as a consensus signal. It never replaces
# the explainable vision read, and it is skipped when the crop is outside the
# model's label set.
HF_API_TOKEN=
# HF_DISEASE_MODEL=linkanjarad/mobilenet_v2_1.0_224-plant-disease-identification
# HF_TIMEOUT_MS=12000

# Optional: Sentinel-2 vegetation checks through the Copernicus Data Space
# Sentinel Hub Statistical API. Create a free OAuth client in the CDSE
# dashboard. Leave empty to show the honest "not connected" state.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
# CDSE_STATISTICS_URL=https://sh.dataspace.copernicus.eu/api/v1/statistics
# SATELLITE_LOOKBACK_DAYS=45
# SATELLITE_MAX_CLOUD=45
